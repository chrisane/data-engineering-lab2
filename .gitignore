# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------
# Generated synthetic source data
# Recreate with: python scripts/generate_all.py
# ---------------------------------------------------------
data/incoming/*.xlsx
data/incoming/*.csv
data/incoming/cashups/*.pdf
data/.generating/

# ---------------------------------------------------------
# Pipeline outputs (created when the pipeline runs)
# ---------------------------------------------------------
data/raw/*
data/quarantine/*
data/processed/*
data/archive/*
!data/*/.gitkeep

# Withdrawn legacy cash-up documents (see config/source_registry.yaml,
# withdrawn_files) are kept under version control as evidence.
!data/archive/legacy_cashups/

logs/*
!logs/.gitkeep

# ---------------------------------------------------------
# Editor and OS files
# ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------
# Environment files
# ---------------------------------------------------------
.env